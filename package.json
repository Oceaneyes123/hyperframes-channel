{
  "name": "hyperframes-channel-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "fontawesome-icon": "node scripts/fontawesome_icon.mjs",
    "icons8-icon": "node scripts/icons8_icon.mjs",
    "tts": "python scripts/supertonic_tts.py",
    "assemble": "python scripts/assemble_project.py",
    "sync:channel": "python scripts/sync_channel_assets.py --all",
    "validate": "python scripts/validate_project.py",
    "validate:all": "python scripts/validate_project.py --all --stage plan",
    "test": "python -m unittest discover -s scripts -p \"test_*.py\""
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1"
  }
}

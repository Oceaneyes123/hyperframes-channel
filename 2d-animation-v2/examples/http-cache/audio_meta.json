  "voice": "custom:channel-voice.json",
  "timeline_duration_s": 99.96666666666667,
  "voices": [
    {
      "id": "line-1",
      "path": ".media/audio/voice/line-1.wav",
      "duration_s": 4.667210884353741,
      "voice_style_sha256": "c537c5f830347b971f29add657dc0f0376945ec73b0a5a6412bd06d715f4dd91",
      "original_text": "This browser's image copy expired. So why is it still here?",
      "spoken_text": "This browser's image copy expired. So why is it still here?",
      "normalization_fingerprint": "1084833fc8785f1ff0cac49f65ef99d920430397238ffa11dc5045035100a75a",
      "frame": 1
    },
    {
      "id": "line-2",
      "path": ".media/audio/voice/line-2.wav",
      "duration_s": 9.195102040816327,
      "voice_style_sha256": "c537c5f830347b971f29add657dc0f0376945ec73b0a5a6412bd06d715f4dd91",
      "original_text": "Because expiration ends its freshness, not its existence. A browser cache can keep a stored response, including the image.",
      "spoken_text": "Because expiration ends its freshness, not its existence. A browser cache can keep a stored response, including the image.",
      "normalization_fingerprint": "1084833fc8785f1ff0cac49f65ef99d920430397238ffa11dc5045035100a75a",
      "frame": 2
    },
    {
      "id": "line-3",
      "path": ".media/audio/voice/line-3.wav",
      "duration_s": 8.777142857142858,
      "voice_style_sha256": "c537c5f830347b971f29add657dc0f0376945ec73b0a5a6412bd06d715f4dd91",
      "original_text": "If the rules allow it, a fresh copy can be reused without checking with the server. That saves another transfer of the image.",
      "spoken_text": "If the rules allow it, a fresh copy can be reused without checking with the server. That saves another transfer of the image.",
      "normalization_fingerprint": "1084833fc8785f1ff0cac49f65ef99d920430397238ffa11dc5045035100a75a",
      "frame": 3
    },
    {
      "id": "line-4",
      "path": ".media/audio/voice/line-4.wav",
      "duration_s": 7.523265306122449,
      "voice_style_sha256": "c537c5f830347b971f29add657dc0f0376945ec73b0a5a6412bd06d715f4dd91",
      "original_text": "But once this copy becomes stale, the browser may need to check before reusing it. Stale doesn't mean deleted.",
      "spoken_text": "But once this copy becomes stale, the browser may need to check before reusing it. Stale doesn't mean deleted.",
      "normalization_fingerprint": "1084833fc8785f1ff0cac49f65ef99d920430397238ffa11dc5045035100a75a",
      "frame": 4
    },
    {
      "id": "line-5",
      "path": ".media/audio/voice/line-5.wav",
      "duration_s": 10.588299319727891,
      "voice_style_sha256": "c537c5f830347b971f29add657dc0f0376945ec73b0a5a6412bd06d715f4dd91",
      "original_text": "For this example, the server gave the image an ETag: a label for that version. The browser sends that saved label in a conditional request.",
      "spoken_text": "For this example, the server gave the image an ETag: a label for that version. The browser sends that saved label in a conditional request.",
      "normalization_fingerprint": "1084833fc8785f1ff0cac49f65ef99d920430397238ffa11dc5045035100a75a",
      "frame": 5
    },
    {
      "id": "line-6",
      "path": ".media/audio/voice/line-6.wav",
      "duration_s": 9.195102040816327,
      "voice_style_sha256": "c537c5f830347b971f29add657dc0f0376945ec73b0a5a6412bd06d715f4dd91",
      "original_text": "It's asking, \u201cDoes your current image still match this version?\u201d The request carries the label; it doesn't send the saved image back.",
      "spoken_text": "It's asking, \u201cDoes your current image still match this version?\u201d The request carries the label; it doesn't send the saved image back.",
      "normalization_fingerprint": "1084833fc8785f1ff0cac49f65ef99d920430397238ffa11dc5045035100a75a",
      "frame": 6
    },
    {
      "id": "line-7",
      "path": ".media/audio/voice/line-7.wav",
      "duration_s": 11.981496598639456,
      "voice_style_sha256": "c537c5f830347b971f29add657dc0f0376945ec73b0a5a6412bd06d715f4dd91",
      "original_text": "If the version still matches, the server can reply \u201c304 Not Modified.\u201d No new image body comes with that reply, so the browser reuses its stored body.",
      "spoken_text": "If the version still matches, the server can reply \u201c304 Not Modified.\u201d No new image body comes with that reply, so the browser reuses its stored body.",
      "normalization_fingerprint": "1084833fc8785f1ff0cac49f65ef99d920430397238ffa11dc5045035100a75a",
      "frame": 7
    },
    {
      "id": "line-8",
      "path": ".media/audio/voice/line-8.wav",
      "duration_s": 11.00625850340136,
      "voice_style_sha256": "c537c5f830347b971f29add657dc0f0376945ec73b0a5a6412bd06d715f4dd91",
      "original_text": "If the image has changed instead, the server can reply \u201c200 OK\u201d with the new image. The browser can store that response and use the replacement.",
      "spoken_text": "If the image has changed instead, the server can reply \u201c200 OK\u201d with the new image. The browser can store that response and use the replacement.",
      "normalization_fingerprint": "1084833fc8785f1ff0cac49f65ef99d920430397238ffa11dc5045035100a75a",
      "frame": 8
    },
    {
      "id": "line-9",
      "path": ".media/audio/voice/line-9.wav",
      "duration_s": 9.891700680272109,
      "voice_style_sha256": "c537c5f830347b971f29add657dc0f0376945ec73b0a5a6412bd06d715f4dd91",
      "original_text": "These are permitted cache paths, not a rule for every request or reload. Cache instructions and whether the copy is still stored matter.",
      "spoken_text": "These are permitted cache paths, not a rule for every request or reload. Cache instructions and whether the copy is still stored matter.",
      "normalization_fingerprint": "1084833fc8785f1ff0cac49f65ef99d920430397238ffa11dc5045035100a75a",
      "frame": 9
    },
    {
      "id": "line-10",
      "path": ".media/audio/voice/line-10.wav",
      "duration_s": 8.916462585034013,
      "voice_style_sha256": "c537c5f830347b971f29add657dc0f0376945ec73b0a5a6412bd06d715f4dd91",
      "original_text": "So an expired copy can still be useful. A matching server check can let your browser reuse the image it already has.",
      "spoken_text": "So an expired copy can still be useful. A matching server check can let your browser reuse the image it already has.",
      "normalization_fingerprint": "1084833fc8785f1ff0cac49f65ef99d920430397238ffa11dc5045035100a75a",
      "frame": 10
    }
  ],

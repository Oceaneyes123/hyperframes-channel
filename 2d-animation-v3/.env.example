# Paths are relative to 2d-animation-v3. Keep local storage inside v3.
V3_DATA_DIR=.data
V3_VIDEOS_DIR=videos
# Optional, server-only gateway settings.
# CLIPROXYAPI_BASE_URL=http://127.0.0.1:8317/v1
# CLIPROXYAPI_API_KEY=
# CLIPROXYAPI_MODEL=
# Concepts, storyboards and shot revisions; falls back to CLIPROXYAPI_MODEL.
# CLIPROXYAPI_VISUAL_MODEL=gpt-6.1-sol
# Optional per-role overrides. Director/critic fall back to VISUAL_MODEL, then MODEL.
# Writer/motion fall back to MODEL. Settings do not change existing artifacts.
# CLIPROXYAPI_DIRECTOR_MODEL=
# CLIPROXYAPI_WRITER_MODEL=
# CLIPROXYAPI_MOTION_MODEL=
# CLIPROXYAPI_CRITIC_MODEL=
# Explicitly registered accepted examples, comma-separated UUIDs (maximum three).
# V3_CREATIVE_EXAMPLE_IDS=

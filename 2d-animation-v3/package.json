{
  "name": "hyperframes-studio-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.6.0 <25"
  },
  "scripts": {
    "workflow": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/workflow.ts",
    "dev": "next dev --hostname 127.0.0.1 --port 3003",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3003",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts",
    "db:init": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/init-db.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/gsap": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "gsap": "3.15.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}

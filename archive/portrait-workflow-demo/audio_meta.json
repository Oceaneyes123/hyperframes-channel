  "timeline_duration_s": 39.70612244897959,
  "voices": [
    {
      "id": "line-1",
      "path": ".media/audio/voice/line-1.wav",
      "duration_s": 6.617687074829932,
      "original_text": "When you type a site name, your computer still needs an IP address before it can contact that site.",
      "spoken_text": "When you type a site name, your computer still needs an I P address before it can contact that site.",
      "normalization_fingerprint": "76e03275dd574d1d8bc9432cf428249c33bd67230ba2ab046ae91fb7d4294684",
      "frame": 1
    },
    {
      "id": "line-2",
      "path": ".media/audio/voice/line-2.wav",
      "duration_s": 6.548027210884354,
      "original_text": "It sends a name lookup to a DNS resolver, a service built to find addresses for names.",
      "spoken_text": "It sends a name lookup to a D N S resolver, a service built to find addresses for names.",
      "normalization_fingerprint": "76e03275dd574d1d8bc9432cf428249c33bd67230ba2ab046ae91fb7d4294684",
      "frame": 2
    },
    {
      "id": "line-3",
      "path": ".media/audio/voice/line-3.wav",
      "duration_s": 5.712108843537415,
      "original_text": "For this example, the resolver returns 192.0.2.10.",
      "spoken_text": "For this example, the resolver returns one hundred ninety two dot zero dot two dot ten.",
      "normalization_fingerprint": "76e03275dd574d1d8bc9432cf428249c33bd67230ba2ab046ae91fb7d4294684",
      "frame": 3
    },
    {
      "id": "line-4",
      "path": ".media/audio/voice/line-4.wav",
      "duration_s": 5.921088435374149,
      "original_text": "The answer travels back to your computer, which can now send the real request to that address.",
      "spoken_text": "The answer travels back to your computer, which can now send the real request to that address.",
      "normalization_fingerprint": "76e03275dd574d1d8bc9432cf428249c33bd67230ba2ab046ae91fb7d4294684",
      "frame": 4
    },
    {
      "id": "line-5",
      "path": ".media/audio/voice/line-5.wav",
      "duration_s": 7.523265306122449,
      "original_text": "Next time, while that cached answer is still valid, the resolver can answer nearby without asking upstream again.",
      "spoken_text": "Next time, while that cached answer is still valid, the resolver can answer nearby without asking upstream again.",
      "normalization_fingerprint": "76e03275dd574d1d8bc9432cf428249c33bd67230ba2ab046ae91fb7d4294684",
      "frame": 5
    },
    {
      "id": "line-6",
      "path": ".media/audio/voice/line-6.wav",
      "duration_s": 7.383945578231293,
      "original_text": "Remember the model: a name goes in, an IP address comes out, and that address tells the request where to go.",
      "spoken_text": "Remember the model: a name goes in, an I P address comes out, and that address tells the request where to go.",
      "normalization_fingerprint": "76e03275dd574d1d8bc9432cf428249c33bd67230ba2ab046ae91fb7d4294684",
      "frame": 6
    }
  ],
